{
  "name": "globo-systems",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "hello": "echo 'Hello, NPM Scripts!'",
    "dev:ts": "tsx watch packages/server/src --exec 'tsx packages/server/src/index.ts'",
    "dev:sass": "sass --watch src/styles.scss:./dist/styles.css",
    "build:ts": "tsc -b packages/server",
    "build:sass": "sass packages/server/src/styles.scss packages/server/dist/styles.css",
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "prepare": "husky",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prebuild": "echo Starting build...",
    "postbuild": "echo Build complete!",
    "build": "cross-env NODE_ENV=production npm run build:ts && npm run build:sass"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "c8": "^12.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "sass": "^1.104.1",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
